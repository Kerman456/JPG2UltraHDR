* text=auto eol=lf

# Windows 批处理必须是 CRLF，否则某些 cmd 解析会出错
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制资源，不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.jar binary
*.jks binary
*.keystore binary
*.so binary

# Gradle wrapper 是 POSIX shell 脚本：必须保持 LF 且有执行位
android-app/android/gradlew text eol=lf
